{% extends 'base.html.twig' %}

{% block title %}Se connecter
{% endblock %}

{% block body %}
	<div class="container login-page">
		<div class="card card-fill">
			<div class="card-body">
				<div class="login-panel mx-auto">
					<h1 class="text-center mb-4 fs-4">Se connecter à l'application
						{{ appName }}</h1>
					<form method="post" id="login_form" action="{{ path('app_login') }}" data-turbo="false">
						{% if error %}
							<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
						{% endif %}

                        {% if device_limit_error %}
							<div class="alert alert-danger">
								Vous avez déjà 2 appareils actifs. Déconnectez un ancien appareil avant d'en ajouter un nouveau.
							</div>
						{% endif %}

						{% if device_revoked %}
							<div class="alert alert-success">
								Cet appareil a été révoqué. Vous avez été déconnecté.
							</div>
						{% endif %}

						{% if app.user %}
							<div class="mb-3">
								You are logged in as
								{{ app.user.userIdentifier }},
								<a href="{{ path('app_logout') }}">Logout</a>
							</div>
						{% endif %}

						<div class="form-group mb-3">
							<label for="username" class="form-label lh-label fw-semibold">Votre email :</label>
							<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control form-control-login" autocomplete="email" required autofocus placeholder="e.g. picard@starfleet.org">
						</div>
						<div class="form-group mb-3">
							<label for="password" class="form-label lh-label fw-semibold">Votre mot de passe :</label>
							<div class="toggle-password-container">
								<input type="password" name="_password" id="password" class="form-control form-control-login" autocomplete="current-password" required placeholder="••••••••" data-controller="toggle-password" data-toggle-password-visible-label-value="Afficher" data-toggle-password-hidden-label-value="Masquer" data-toggle-password-button-classes-value='["toggle-password-button"]'>
							</div>
						</div>

						{% set targetPath = app.request.query.get('_target_path') %}
						{% if targetPath %}
							<input type="hidden" name="_target_path" value="{{ targetPath }}">
						{% endif %}
						<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

						<button class="btn btn-md btn-dark" type="submit">
							<span>Se connecter</span>
						</button>
						<div class="row mt-3">
							<div class="checkbox col-md-6 text-start">
								<label for="remember_me" class="remember-me-label">
									<input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input remember-me-checkbox">
									Se souvenir de moi
								</label>
							</div>
						</div>
					</form>
					<div class="d-flex flex-column text-center mt-4">
						<span class="text-muted">Pas encore inscrit(e) ?
							<a href="{{ path('app_register', { _target_path: app.request.query.get('_target_path') }) }}">M'inscrire</a>
						</span>
						<span class="text-muted">
							Vous avez oublié votre mot de passe&nbsp;?
							<u>
								<a href="{{ path('app_forgot_pw') }}" class="text-decoration-none">Le réinitialiser</a>
							</u>
						</span>
						<span class="text-muted">
							Vous avez oublié votre identifiant&nbsp;?
							<u>
								<a href="{{ path('app_forgot_identifier') }}" class="text-decoration-none">Demander de l’aide</a>
							</u>
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
