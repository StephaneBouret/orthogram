<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width">
        <title>Signalement d’un commentaire</title>
    </head>
    <body style="margin:0;padding:0;background:#FFF8EC;font-family:Arial,Helvetica,sans-serif;color:#222;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FFF8EC;">
            <tr>
                <td align="center">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;background:#ffffff;">
                        <tr>
                            <td style="padding:32px;">
                                <h1 style="margin:0 0 20px;color:#D87900;font-size:28px;">Commentaire signalé</h1>

                                <p style="font-size:16px;line-height:1.5;">
                                    Un utilisateur a signalé un commentaire sur Orthogram.
                                </p>

                                <p style="font-size:16px;line-height:1.5;">
                                    <strong>Signalé par :</strong>
                                    {{ reporter ? reporter.fullname : 'Utilisateur inconnu' }}
                                    {% if reporter and reporter.email %}({{ reporter.email }}){% endif %}
                                </p>

                                {% if comment %}
                                    <p style="font-size:16px;line-height:1.5;">
                                        <strong>Auteur du commentaire :</strong>
                                        {{ comment.user ? comment.user.fullname : 'Utilisateur inconnu' }}
                                        {% if comment.user and comment.user.email %}({{ comment.user.email }}){% endif %}
                                    </p>

                                    <p style="font-size:16px;line-height:1.5;">
                                        <strong>Cours :</strong>
                                        {{ comment.course ? comment.course.name : 'Cours inconnu' }}
                                    </p>
                                {% endif %}

                                <div style="margin:24px 0;padding:18px;border-left:4px solid #FF9F0A;background:#FFF8EC;font-size:16px;line-height:1.5;">
                                    {{ report.commentContent|nl2br }}
                                </div>

                                <p style="font-size:14px;line-height:1.5;color:#555;">
                                    Signalement reçu le {{ report.createdAt|date('d/m/Y à H:i') }}.
                                </p>

                                <p style="margin:28px 0 0;">
                                    <a href="{{ absolute_url(adminReportUrl) }}" style="display:inline-block;padding:12px 22px;border-radius:8px;background:#111;color:#fff;text-decoration:none;font-weight:700;">
                                        Voir le signalement
                                    </a>
                                </p>

                                {% if courseUrl %}
                                    <p style="margin:18px 0 0;font-size:14px;line-height:1.5;">
                                        Page du cours :
                                        <a href="{{ courseUrl }}" style="color:#D87900;">{{ courseUrl }}</a>
                                    </p>
                                {% endif %}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
