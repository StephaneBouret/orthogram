<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width">
		<title>Code de vérification Orthogram</title>

		<style>
			body {
				margin: 0;
				padding: 0;
				background: #FFF8EC;
				font-family: Arial, Helvetica, sans-serif;
			}

			table {
				border-collapse: collapse;
			}

			a {
				text-decoration: none;
			}

			.container {
				width: 100%;
				max-width: 600px;
				background: #ffffff;
				table-layout: fixed;
			}

			.px {
				padding-left: 32px;
				padding-right: 32px;
			}

			.brand {
				font-size: 34px;
				font-weight: 700;
				color: #111111;
			}

			.orange {
				color: #FF9F0A;
			}

			.title {
				color: #D87900;
			}

			.text {
				color: #222222;
				font-size: 16px;
				line-height: 1.45;
				overflow-wrap: break-word;
				word-break: break-word;
			}

			.btn {
				display: inline-block;
				padding: 14px 32px;
				border-radius: 8px;
				font-size: 16px;
				font-weight: 700;
			}

			.btn-black {
				background: #111111;
				color: #ffffff !important;
			}

			.btn-orange {
				background: #FF9F0A;
				color: #111111 !important;
			}

			.divider {
				border-bottom: 5px dotted #FF9F0A;
				height: 1px;
				line-height: 1px;
				font-size: 1px;
			}

			.auth-code {
				color: #111111;
				font-size: 42px;
				font-weight: 700;
				letter-spacing: 8px;
				line-height: 1.2;
			}

			@media only screen and (max-width: 620px) {
				.container {
					width: 100% !important;
					max-width: 100% !important;
				}

				.px {
					padding-left: 18px !important;
					padding-right: 18px !important;
				}

				.brand {
					font-size: 30px !important;
				}

				.header-cell {
					display: block !important;
					width: 100% !important;
					text-align: center !important;
				}

				.header-button {
					display: block !important;
					width: 100% !important;
					text-align: center !important;
					padding-top: 20px !important;
				}

				.header-button .btn {
					display: inline-block !important;
					width: auto !important;
				}

				.main-title {
					font-size: 32px !important;
				}

				.auth-code {
					font-size: 34px !important;
					letter-spacing: 5px !important;
				}

				.btn {
					text-align: center !important;
					padding-left: 16px !important;
					padding-right: 16px !important;
				}
			}
		</style>
	</head>

	<body>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FFF8EC;">
			<tr>
				<td align="center">

					<table role="presentation" class="container" width="100%" cellpadding="0" cellspacing="0">
						<tr>
							<td class="px" style="padding-top:32px;padding-bottom:32px;">
								<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
									<tr>
										<td align="left" class="header-cell">
											<a href="{{ absolute_url(path('app_home')) }}" target="_blank" class="brand">
												<span class="orange">O</span>rthogram
											</a>
										</td>

										<td align="right" class="header-button">
											<a href="{{ absolute_url(path('app_home')) }}" target="_blank" class="btn btn-orange">
												Accueil
											</a>
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<tr>
							<td class="px" style="background:#FF9F0A;padding-top:36px;padding-bottom:36px;">
								<h2 style="margin:0;color:#111111;font-size:26px;line-height:1.3;">
									Code de vérification
								</h2>

								<p class="text" style="margin:22px 0 0;color:#111111;">
									Bonjour {{ user.firstname|default(user.email) }},
								</p>

								<p class="text" style="margin:14px 0 0;color:#111111;">
									Utilisez ce code pour finaliser votre connexion à votre compte Orthogram.
								</p>
							</td>
						</tr>

						<tr>
							<td class="px" style="padding-top:44px;padding-bottom:34px;">
								<h1 class="title main-title" style="margin:0;text-align:center;font-size:42px;line-height:1.2;">
									Votre code sécurisé
								</h1>

								<h3 class="title" style="margin:28px 0 0;text-align:center;font-size:20px;">
									Valable pendant 30 minutes
								</h3>

								<div class="divider" style="margin:34px 0;"></div>

								<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #FFB84D;border-radius:10px;">
									<tr>
										<td align="center" style="padding:28px 22px;">
											<p class="text" style="margin:0 0 14px;">
												Code à saisir sur la page de connexion :
											</p>

											<div class="auth-code" style="color:#111111;font-size:42px;font-weight:700;letter-spacing:8px;line-height:1.2;">
												{{ authCode }}
											</div>
										</td>
									</tr>
								</table>

								<div class="divider" style="margin:34px 0;"></div>

								<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #FFB84D;border-radius:10px;">
									<tr>
										<td style="padding:24px 22px;">
											<h3 class="title" style="margin:0 0 12px;font-size:20px;">
												Bon à savoir
											</h3>

											<p class="text" style="margin:0 0 8px;">
												Si vous n'êtes pas à l'origine de cette connexion, vous pouvez ignorer cet email.
											</p>

											<p class="text" style="margin:0;">
												Un nouveau code sera généré si vous rechargez la page de connexion ou si vous ouvrez une nouvelle tentative de connexion.
											</p>
										</td>
									</tr>
								</table>

								<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:30px;">
									<tr>
										<td align="center">
											<a href="{{ absolute_url(path('app_login')) }}" target="_blank" class="btn btn-orange">
												Retour à la connexion
											</a>
										</td>
									</tr>
								</table>
							</td>
						</tr>
					</table>

				</td>
			</tr>
		</table>
	</body>
</html>
