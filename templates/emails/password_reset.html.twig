<p style="font-family: Arial, sans-serif; line-height: 1.6; margin: 24px 0;">
    <a href="{{ url }}" style="background-color: #f59e0b; border-radius: 6px; color: #111827; display: inline-block; font-weight: 700; padding: 12px 18px; text-decoration: none;">Modification du mot de passe</a>
