<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width">
		<title>{{ title }}</title>

		<style>
			body {
				margin: 0;
				padding: 0;
				background: #FFF8EC;
				font-family: Arial, Helvetica, sans-serif;
			}

			table {
				border-collapse: collapse;
			}

			a {
				text-decoration: none;
			}

			.container {
				width: 100%;
				max-width: 600px;
				background: #ffffff;
				table-layout: fixed;
			}

			.px {
				padding-left: 32px;
				padding-right: 32px;
			}

			.brand {
				font-size: 34px;
				font-weight: 700;
				color: #111111;
			}

			.orange {
				color: #FF9F0A;
			}

			.title {
				color: #D87900;
			}

			.text {
				color: #222222;
				font-size: 16px;
				line-height: 1.45;
				overflow-wrap: break-word;
				word-break: break-word;
			}

			.btn {
				display: inline-block;
				padding: 14px 32px;
				border-radius: 8px;
				font-size: 16px;
				font-weight: 700;
			}

			.btn-black {
				background: #111111;
				color: #ffffff !important;
			}

			.btn-orange {
				background: #FF9F0A;
				color: #111111 !important;
			}

			.divider {
				border-bottom: 5px dotted #FF9F0A;
				height: 1px;
				line-height: 1px;
				font-size: 1px;
			}

			@media only screen and (max-width: 620px) {
				.container {
					width: 100% !important;
					max-width: 100% !important;
				}

				.px {
					padding-left: 18px !important;
					padding-right: 18px !important;
				}

				.brand {
					font-size: 30px !important;
				}

				.main-title {
					font-size: 32px !important;
				}

				.btn {
					text-align: center !important;
					padding-left: 16px !important;
					padding-right: 16px !important;
				}
			}
		</style>
	</head>

	<body>
		<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FFF8EC;">
			<tr>
				<td align="center">
					<table role="presentation" class="container" width="100%" cellpadding="0" cellspacing="0">
						<tr>
							<td class="px" style="padding-top:32px;padding-bottom:32px;">
								<a href="{{ absolute_url(path('app_home')) }}" target="_blank" class="brand">
									<span class="orange">O</span>rthogram
								</a>
							</td>
						</tr>

						<tr>
							<td class="px" style="background:#FF9F0A;padding-top:36px;padding-bottom:36px;">
								<h2 style="margin:0;color:#111111;font-size:26px;line-height:1.3;">
									{{ title }}
								</h2>

								<p class="text" style="margin:22px 0 0;color:#111111;">
									{{ message }}
								</p>

								<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:32px;">
									<tr>
										<td align="center">
											<a href="{{ actionUrl }}" target="_blank" class="btn btn-black">
												{{ actionLabel }}
											</a>
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<tr>
							<td class="px" style="padding-top:44px;padding-bottom:34px;">
								<h1 class="title main-title" style="margin:0;text-align:center;font-size:42px;line-height:1.2;">
									Votre compte
								</h1>

								<h3 class="title" style="margin:28px 0 0;text-align:center;font-size:20px;">
									{{ user.fullname }}
								</h3>

								<div class="divider" style="margin:34px 0;"></div>

								<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #FFB84D;border-radius:10px;">
									<tr>
										<td style="padding:24px 22px;">
											<h3 class="title" style="margin:0 0 12px;font-size:20px;">
												Détails
											</h3>

											<p class="text" style="margin:0 0 8px;">
												Email :
												<strong>{{ user.email }}</strong>
											</p>

											<p class="text" style="margin:0;">
												Statut :
												<strong>{{ user.accountStatusLabel }}</strong>
											</p>
										</td>
									</tr>
								</table>

								<p class="text" style="margin:30px 0 0;font-size:13px;line-height:1.5;">
									Si le bouton ne fonctionne pas, copiez-collez ce lien dans votre navigateur :
									<br>
									<a href="{{ actionUrl }}" target="_blank" style="color:#D87900;word-break:break-all;overflow-wrap:break-word;">
										{{ actionUrl }}
									</a>
								</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
