<button type="button" class="btn course-display-toggle" data-action="fullscreen#toggle" data-fullscreen-target="button" aria-controls="customer-sidebar">
    <span data-fullscreen-target="expandIcon" aria-hidden="true">
        {% include 'course/program_summary/icons/_fullscreen_open.html.twig' %}
    </span>
    <span data-fullscreen-target="restoreIcon" class="d-none" aria-hidden="true">
        {% include 'course/program_summary/icons/_fullscreen_close.html.twig' %}
    </span>
    <span data-fullscreen-target="label">Agrandir l’affichage</span>
</button>
