{% set programTotalHours = (programTotalDurationMinutes / 60)|round(0, 'floor') %}
{% set programRemainingMinutes = programTotalDurationMinutes % 60 %}

<div
    class="main-content"
    data-controller="learning-reminder"
    data-action="turbo:before-cache@document->learning-reminder#prepareForCache"
>
    <div class="d-flex">
        <div class="w-100">
            <div class="d-md-flex justify-content-md-between align-items-center spacer-section">
                <div class="flex-fill mb-6 mb-md-0">
                    <nav aria-label="Fil d’Ariane">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="{{ path('app_home') }}" class="text-muted">Accueil</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Ma formation</li>
                        </ol>
                    </nav>

                    <div class="course-mobile-menu d-md-none" data-controller="course-menu">
                        <button type="button" class="course-mobile-menu-toggle" aria-expanded="false" data-action="course-menu#toggle" data-course-menu-target="button">
                            <span>{{ program.name }}</span>
                            {% include 'course/program_summary/icons/_opened.html.twig' %}
                        </button>
                        <div class="course-mobile-menu-panel d-none" data-course-menu-target="panel">
                            {% include 'course/program_summary/_sidebar_content.html.twig' with { collapsePrefix: 'mobile' } %}
                        </div>
                    </div>

                    <h1 class="pr-md-6 d-md-block fw-semibold d-none">{{ program.name }}</h1>
                </div>

                <div class="mt-n2 mt-md-0">
                    <div class="btn-row d-none d-md-flex">
                        <button type="button" title="Agrandir la formation" aria-label="Agrandir la formation" aria-pressed="false" data-action="fullscreen#toggle" data-fullscreen-target="openButton" class="btn btn-md btn-outline-grey btn-icon">
                            {% include 'course/program_summary/icons/_fullscreen_open.html.twig' %}
                        </button>
                        <button type="button" title="Réduire la formation" aria-label="Réduire la formation" aria-pressed="true" data-action="fullscreen#toggle" data-fullscreen-target="closeButton" class="btn btn-md btn-outline-grey btn-icon d-none">
                            {% include 'course/program_summary/icons/_fullscreen_close.html.twig' %}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="program-summary-overview spacer-section" aria-label="Présentation de la formation">
        {% if program.description %}
            <div class="program-summary-lead">
                {{ program.description|raw|nl2br }}
            </div>
        {% endif %}

        <div class="program-summary-stats" aria-label="Votre progression dans la formation">
            <div class="program-summary-stat">
                <span class="program-summary-stat-icon" aria-hidden="true">
                    <i class="bi bi-check2-circle"></i>
                </span>
                <span class="program-summary-stat-content">
                    <strong>{{ nbrLessonsDone }} / {{ nbrCourses }}</strong>
                    <span>Cours terminés</span>
                </span>
            </div>

            <div class="program-summary-stat">
                <span class="program-summary-stat-icon" aria-hidden="true">
                    <i class="bi bi-clock"></i>
                </span>
                <span class="program-summary-stat-content">
                    <strong>
                        {% if programTotalHours > 0 %}
                            {{ programTotalHours }} h{% if programRemainingMinutes > 0 %} {{ programRemainingMinutes }} min{% endif %}
                        {% else %}
                            {{ programRemainingMinutes }} min
                        {% endif %}
                    </strong>
                    <span>Durée totale</span>
                </span>
            </div>
        </div>
    </section>

    <div
        class="program-schedule-section spacer-section"
        data-learning-reminder-target="section"
    >
        <section class="program-schedule-card" aria-labelledby="program-schedule-title">
            <div class="program-schedule-icon" aria-hidden="true">
                <i class="bi bi-alarm"></i>
            </div>
            <div class="program-schedule-content">
                <div class="program-schedule-heading">
                    <h2 id="program-schedule-title">Programmer du temps pour apprendre</h2>
                    <span class="program-schedule-badge">Planification</span>
                </div>
                <p>
                    Une pratique courte et régulière aide à ancrer durablement les règles.
                    Préparez un rythme d’apprentissage adapté à votre emploi du temps.
                </p>
                <div class="program-schedule-actions" aria-label="Actions de planification">
                    <button
                        type="button"
                        class="program-schedule-button learning-reminder-trigger learning-reminder-trigger-primary"
                        aria-haspopup="dialog"
                        aria-controls="learningReminderModal"
                        data-action="learning-reminder#open"
                    >
                        Commencer
                    </button>
                    <button
                        type="button"
                        class="program-schedule-button learning-reminder-trigger learning-reminder-trigger-secondary"
                        data-action="learning-reminder#reject"
                    >
                        Rejeter
                    </button>
                </div>
            </div>
        </section>
    </div>

    {% include 'course/program_summary/_learning_reminder_modal.html.twig' %}

    <section class="program-course-content" aria-labelledby="program-course-content-title">
        <header class="program-course-content-heading">
            <div>
                <h2
                    id="program-course-content-title"
                    class="learning-reminder-focus-target"
                    tabindex="-1"
                    data-learning-reminder-target="courseContentTitle"
                >
                    Contenu de la formation
                </h2>
                <p>
                    {{ sections|length }} {{ sections|length > 1 ? 'sections' : 'section' }}
                    · {{ nbrCourses }} cours
                </p>
            </div>
        </header>

        {% for section in sections %}
            {% set courseCount = coursesBySection[section.id] ?? section.courses|length %}
            {% set sectionDuration = sectionsTotalDuration[section.id] ?? 0 %}
            <div class="card v9d3ks" id="section-{{ section.id }}">
                <div class="card-body">
                    <div class="list-group list-group-menu list-group-sm">
                        <nav aria-label="{{ section.name }}">
                            <header class="pb7jep">
                                <a class="lk25pol" href="{{ path('app_course_section', {'programSlug': program.slug, 'sectionSlug': section.slug}) }}">
                                    <h2>
                                        {{ section.name }}
                                        {% if sectionDuration > 0 %}
                                            ({{ sectionDuration }} min)
                                        {% endif %}
                                    </h2>
                                </a>
                                {% if section.shortDescription %}
                                    <div class="text-longform text-lg text-muted mb-2">
                                        <div>{{ section.shortDescription|raw|nl2br }}</div>
                                    </div>
                                {% endif %}
                                <h3 class="mt-8 mb-4">
                                    {{ courseCount }} cours
                                </h3>
                            </header>
                            <ol class="pl-0 mb-0 list-unstyled">
                                {% for course in section.courses %}
                                    <li>
                                        {% include 'course/program_summary/_course_item.html.twig' with { course: course } %}
                                    </li>
                                {% else %}
                                    <li class="text-muted">Aucun cours pour le moment</li>
                                {% endfor %}
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="card v9d3ks">
                <div class="card-body">
                    <p class="mb-0 text-muted">Le sommaire de ce programme sera bientôt disponible.</p>
                </div>
            </div>
        {% endfor %}
    </section>

    <div class="spacer-section"></div>
</div>
