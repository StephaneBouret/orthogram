{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    {# History must fetch current progress, not restore an outdated sidebar. #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block title %}{{ course.name }}{% endblock %}

{% block body %}
    <div class="course-page container-fluid container-padding" id="show"
         {% if canInteract %}
         data-controller="course-bookmark"
         data-course-bookmark-url-value="{{ path('app_course_bookmark', {id: course.id}) }}"
         data-course-bookmark-token-value="{{ csrf_token('course_bookmark_' ~ app.user.id ~ '_' ~ course.id) }}"
         data-course-bookmark-version-value="{{ app.user.courseBookmarkVersion }}"
         data-course-bookmark-account-value="{{ app.user.id }}"
         data-bookmark-account="{{ app.user.id }}"
         {% endif %}>
        <div class="sidebar-container" id="fullContainer" data-controller="fullscreen">
            {% include 'course/program_summary/_sidebar.html.twig' with { currentSection: section, currentCourse: course } %}
            {% include 'course/show/_main.html.twig' %}
        </div>
    </div>
{% endblock %}
