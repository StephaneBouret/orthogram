{% extends 'base.html.twig' %}
{% block title %}{{ writing.title }} — Orthogram{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/dictation.css') }}">
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}
{% block body %}
<main class="container py-4 dictation-page">
    <h1>{{ writing.title }}</h1>
    <p class="alert alert-info">{% if writing.closedResult.noErrors %}Bravo, votre copie ne comporte aucune erreur détectée. {% endif %}Votre copie est clôturée. Les modifications sont fermées jusqu’à la reprise après les cours.</p>
    {% include 'dictation/_summary.html.twig' with {result: writing.closedResult} only %}
    <h2 class="h4">Votre copie clôturée</h2>
    <div class="dictation-frozen" id="dictation-closed-copy">{{ writing.closedCopy }}</div>
    <a class="btn btn-primary mt-3" href="{{ sectionUrl }}">Retour à la section</a>
</main>
{% endblock %}
