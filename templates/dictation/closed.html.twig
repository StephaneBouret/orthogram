{% extends 'base.html.twig' %}
{% block title %}{{ writing.title }} — Orthogram{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/dictation.css') }}">
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}
{% block body %}
<main class="container py-4 dictation-page">
    <h1>{{ writing.title }}</h1>
    <p class="alert alert-info">{% if writing.closedResult.noErrors %}Bravo, aucune erreur ne restait à corriger dans votre copie clôturée. {% endif %}Votre copie est clôturée.
        {% if not writing.coursesComplete %}La reprise et la finalisation seront disponibles après validation de tous les cours de la section.
        {% elseif writing.state == 'awaiting_courses' %}Les cours sont validés. Vous pouvez maintenant reprendre votre dictée.
        {% else %}Vous pouvez terminer pour consulter le corrigé, sans nouvelle saisie ni nouvelle évaluation.{% endif %}</p>
    {% include 'dictation/_summary.html.twig' with {result: writing.closedResult} only %}
    <h2 class="h4">Votre copie clôturée</h2>
    <div class="dictation-frozen" id="dictation-closed-copy">{{ writing.closedCopy }}</div>
    {% if writing.canResume or writing.canFinalize %}
        {% include 'dictation/_phase_action.html.twig' with {writing: writing, action: writing.canResume ? 'resume' : 'finalize', label: writing.canResume ? 'Reprendre ma dictée' : 'Terminer et voir le corrigé'} only %}
    {% endif %}
    <a class="btn btn-primary mt-3" href="{{ sectionUrl }}">Accéder aux cours de la section</a>
</main>
{% endblock %}
