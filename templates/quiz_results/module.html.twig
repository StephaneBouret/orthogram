{% extends 'base.html.twig' %}

{% block title %}Mes résultats — {{ moduleName ?? 'Archives' }} — Orthogram{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <main class="quiz-results container py-5">
        <a class="d-inline-block mb-3" href="{{ path('app_quiz_results') }}">← Tous les modules</a>
        <h1 class="mb-4">Mes résultats — {{ moduleName ?? 'Archives' }}</h1>
        {% include 'course/_resume_results.html.twig' with {resumeLabel: 'Reprendre ma formation'} %}
        {% if moduleName is null %}
            <p class="results-muted">Vos tentatives conservées pour les tests qui ne figurent plus dans le catalogue actuel.</p>
        {% endif %}
        <div class="results-cards">
            {% for card in cards %}
                {% include 'quiz_results/_card.html.twig' with {card: card} only %}
            {% endfor %}
        </div>
    </main>
{% endblock %}
