{% extends 'base.html.twig' %}

{% block title %}Mes résultats — Orthogram{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <main class="quiz-results container py-5">
        <header class="mb-5">
            <h1 class="mb-3">Mes résultats</h1>
            <p class="results-muted mb-0">Retrouvez vos derniers scores et suivez votre évolution.</p>
        </header>

        {% for section in sections %}
            <section class="mb-5" aria-labelledby="results-section-{{ section.id }}">
                <h2 class="h4 mb-4" id="results-section-{{ section.id }}">{{ section.name }}</h2>
                <div class="results-cards">
                    {% for card in section.cards %}
                        {% include 'quiz_results/_card.html.twig' with {card: card} only %}
                    {% endfor %}
                </div>
            </section>
        {% endfor %}

        {% if archives %}
            <section aria-labelledby="results-archives">
                <h2 class="h4 mb-2" id="results-archives">Archives</h2>
                <p class="results-muted mb-4">Vos tentatives conservées pour les tests qui ne figurent plus dans le catalogue actuel.</p>
                <div class="results-cards">
                    {% for card in archives %}
                        {% include 'quiz_results/_card.html.twig' with {card: card} only %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if sections is empty and archives is empty %}
            <div class="results-card text-center py-5">
                <h2 class="h4">Aucun résultat pour le moment</h2>
                <p class="results-muted">Vous n’avez pas encore de tentative enregistrée ni de test accessible.</p>
                <a class="btn btn-outline-secondary" href="{{ path('app_user_subscription_show') }}">Consulter mon abonnement</a>
            </div>
        {% endif %}
    </main>
{% endblock %}
