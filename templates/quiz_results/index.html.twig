{% extends 'base.html.twig' %}

{% block title %}Mes résultats — Orthogram{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body %}
    <main class="quiz-results container py-5">
        <header class="results-overview-heading mb-4">
            <div>
                <h1 class="mb-2">Mes résultats</h1>
                <p class="results-muted mb-0">Choisissez un module pour retrouver vos tests et leurs résultats.</p>
            </div>
            {% include 'course/_resume_results.html.twig' with {resumeLabel: 'Reprendre ma formation'} %}
        </header>

        {% if sections %}
            <div class="results-modules">
                {% for section in sections %}
                    <a class="results-module" href="{{ path('app_quiz_results_module', {id: section.id}) }}">
                        <span class="results-module-icons" aria-hidden="true"><i class="bi bi-book"></i><i class="bi bi-arrow-right"></i></span>
                        <h2 class="h5">{{ section.name }}</h2>
                        <span class="results-muted">{{ section.passed }} {{ section.passed > 1 ? 'tests passés' : 'test passé' }} sur {{ section.total }}</span>
                        <span class="results-progress" aria-hidden="true"><span style="width: {{ 100 * section.passed / section.total }}%"></span></span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}

        {% if hasArchives %}
            <a class="d-inline-block mt-3" href="{{ path('app_quiz_results_archives') }}">Archives</a>
        {% endif %}

        {% if sections is empty and not hasArchives %}
            <div class="results-card text-center py-5">
                <h2 class="h4">Aucun résultat pour le moment</h2>
                <p class="results-muted">Vous n’avez pas encore de tentative enregistrée ni de test accessible.</p>
                <a class="btn btn-outline-secondary" href="{{ path('app_user_subscription_show') }}">Consulter mon abonnement</a>
            </div>
        {% endif %}
    </main>
{% endblock %}
