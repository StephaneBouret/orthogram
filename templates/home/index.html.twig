{% extends 'base.html.twig' %}

{% block title %}Orthogram - Reprendre confiance à l'écrit
{% endblock %}

{% block body %}
	{% set programUrl = program ? path('app_program_show', { slug: program.slug }) : '#' %}

	<div class="home-page">

		<section class="home-hero">
			<div class="home-hero-overlay"></div>

			<div class="container-fluid">
				<div class="row">
					<div class="col-xl-7 col-lg-8">
						<div class="home-hero-content">

							<p class="home-kicker">
								Orthographe • Grammaire • Conjugaison
							</p>

							<h1 class="home-title">
								Reprenez confiance à l'écrit.
							</h1>

							<p class="home-lead">
								Orthogram vous accompagne avec des exercices progressifs,
																								                            un suivi clair et une méthode bienveillante pour écrire
																								                            avec plus d'assurance.
							</p>

							<div class="home-actions">
								<a href="#" class="btn btn-orthogram-primary">
									Commencer par un cours gratuit
								</a>

								<a href="{{ programUrl }}" class="btn btn-orthogram-light">
									Découvrir la méthode
								</a>
							</div>

						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="home-section home-benefits">
			<div class="container-fluid">

				<div class="section-heading text-center">
					<p class="home-kicker">
						Simple, progressif, rassurant
					</p>

					<h2>
						Une méthode pensée pour avancer sans pression.
					</h2>
				</div>

				<div class="row g-4">

					<div class="col-lg-4">
						<article class="benefit-card">
							<div class="benefit-media">
								<img src="{{ asset('img/home/orthogram-progress-everyday.png') }}" alt="Progresser chaque jour" class="benefit-img">
							</div>

							<div class="benefit-content">
								<div class="benefit-icon benefit-icon-purple">
									<i class="bi bi-pencil"></i>
								</div>

								<div>
									<h3>Progresser chaque jour</h3>
									<p>
										Des exercices adaptés à votre niveau pour des progrès visibles et durables.
									</p>
								</div>
							</div>
						</article>
					</div>

					<div class="col-lg-4">
						<article class="benefit-card">
							<div class="benefit-media">
								<img src="{{ asset('img/home/orthogram-follow-progression.png') }}" alt="Suivre sa progression" class="benefit-img">
							</div>

							<div class="benefit-content">
								<div class="benefit-icon benefit-icon-green">
									<i class="bi bi-graph-up-arrow"></i>
								</div>

								<div>
									<h3>Suivre votre progression</h3>
									<p>
										Visualisez vos réussites, vos points forts et les compétences à renforcer.
									</p>
								</div>
							</div>
						</article>
					</div>

					<div class="col-lg-4">
						<article class="benefit-card">
							<div class="benefit-media">
								<img src="{{ asset('img/home/orthogram-achieve-goals.png') }}" alt="Atteindre ses objectifs" class="benefit-img">
							</div>

							<div class="benefit-content">
								<div class="benefit-icon benefit-icon-orange">
									<i class="bi bi-bullseye"></i>
								</div>

								<div>
									<h3>Atteindre vos objectifs</h3>
									<p>
										Brevet, examens, études ou travail : Orthogram vous accompagne à chaque étape.
									</p>
								</div>
							</div>
						</article>
					</div>

				</div>
			</div>
		</section>

		<section class="home-section home-steps">
			<div class="container-fluid">

				<div class="section-heading text-center">
					<p class="home-kicker">Comment ça marche ?</p>
					<h2>Trois étapes simples pour progresser.</h2>
				</div>

				<div class="row g-4">
					<div class="col-lg-4">
						<article class="step-card">
							<span class="step-number">01</span>
							<h3>Choisissez votre objectif</h3>
							<p>Reprendre les bases, préparer un examen ou gagner en assurance à l'écrit.</p>
						</article>
					</div>

					<div class="col-lg-4">
						<article class="step-card">
							<span class="step-number">02</span>
							<h3>Pratiquez régulièrement</h3>
							<p>Des exercices courts pour progresser sans pression, à votre rythme.</p>
						</article>
					</div>

					<div class="col-lg-4">
						<article class="step-card">
							<span class="step-number">03</span>
							<h3>Suivez vos progrès</h3>
							<p>Visualisez vos réussites et identifiez les notions à renforcer.</p>
						</article>
					</div>
				</div>

			</div>
		</section>

		<section class="home-section home-paths">
			<div class="container-fluid">

				<div class="section-heading">
					<p class="home-kicker">
						Parcours Orthogram
					</p>

					<h2>
						Choisissez votre chemin de progression.
					</h2>
				</div>

				<div class="row g-4">

					<div class="col-lg-3 col-md-6">
						<article class="path-card">
							<div class="path-icon">
								✍️
							</div>

							<h3>Orthographe</h3>

							<p>
								Accords, homophones,
																								                            terminaisons et erreurs fréquentes.
							</p>
						</article>
					</div>

					<div class="col-lg-3 col-md-6">
						<article class="path-card">
							<div class="path-icon">
								📘
							</div>

							<h3>Grammaire</h3>

							<p>
								Comprendre les règles essentielles
																								                            pour mieux écrire.
							</p>
						</article>
					</div>

					<div class="col-lg-3 col-md-6">
						<article class="path-card">
							<div class="path-icon">
								⏱️
							</div>

							<h3>Conjugaison</h3>

							<p>
								Maîtriser les temps,
																								                            les verbes et les automatismes.
							</p>
						</article>
					</div>

					<div class="col-lg-3 col-md-6">
						<article class="path-card">
							<div class="path-icon">
								🎯
							</div>

							<h3>Objectifs</h3>

							<p>
								Préparer un examen,
																								                            un concours ou un usage professionnel.
							</p>
						</article>
					</div>

				</div>

			</div>
		</section>

		<section class="home-section home-audience">
			<div class="container-fluid">

				<div class="audience-box">
					<div>
						<p class="home-kicker">Pour qui ?</p>
						<h2>Orthogram accompagne tous ceux qui veulent écrire plus sereinement.</h2>
					</div>

					<div class="audience-tags">
						<span>Collégiens</span>
						<span>Lycéens</span>
						<span>Adultes</span>
						<span>Reprise de confiance</span>
						<span>Examens</span>
						<span>Usage professionnel</span>
					</div>
				</div>

			</div>
		</section>

		<section class="home-section home-method">
			<div class="container-fluid">

				<div class="method-box">

					<div>
						<p class="home-kicker">
							La promesse
						</p>

						<h2>
							Une plateforme qui corrige sans décourager.
						</h2>

						<p>
							Orthogram aide à comprendre ses erreurs,
																					                        à répéter intelligemment et à progresser
																					                        avec des objectifs atteignables.
						</p>
					</div>

					<div>
						<a href="{{ programUrl }}" class="btn btn-orthogram-primary">
							Voir les parcours disponibles
						</a>
					</div>

				</div>

			</div>
		</section>

	</div>
    {% include "shared/_footer_second.html.twig" %}
{% endblock %}
