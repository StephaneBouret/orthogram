{% extends 'base.html.twig' %}

{% block title %}Abonnement Orthogram
{% endblock %}

{% block body %}
<div class="ykzkxt d6i7ks">
	<div class="d-flex">
		<div class="w-100">
			<div class="d-md-flex justify-content-md-between align-items-center spacer-section-checkout">
				<div class="flex-fill mb-6 mb-md-0">
					<h1 class="pr-md-6 bkicbc">Souscription à Orthogram</h1>
				</div>
			</div>
		</div>
	</div>
	<div class="n46nkd right">
		<div class="main-content">
			<div class="d-flex flex-column gap-y-8">
				<div class="xo2a4n pb-7">
					<div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-column">
                                <div class="d8l2ev">Compte</div>
                                <div class="card-subtitle">{{ user.email }}</div>
                            </div>
                            <a class="btn btn gy38mz" href="{{ path('app_logout') }}">Se déconnecter</a>
                        </div>
					</div>
				</div>
				<div class="xo2a4n pb-7">
					<div class="card-header">
						<div class="d-flex justify-content-between align-items-center">
							<div class="d-flex flex-column mr-2 w-100">
								<div class="d8l2ev">Paiement</div>
								<div class="card-body">
									<hr class="my-6">
									<dl class="d-flex flex-column gap-y-2">
										<div class="d-flex justify-content-between">
											<dt class="font-weight-normal">
												{{ subscription.title }}
											</dt>
											<dd class="text-muted">{{ subscription.priceCents | amount }}</dd>
										</div>
										<div class="d-flex justify-content-between">
											<dt class="font-weight-normal text-muted">
												Durée
											</dt>
											<dd class="text-muted">1 an</dd>
										</div>

										{% if subscription.description %}
											<div class="mt-3">
												<dt class="font-weight-normal mb-2">Description</dt>
												<dd class="text-muted mb-0">{{ subscription.description }}</dd>
											</div>
										{% endif %}

										<dl class="d-flex justify-content-between mt-4">
											<dt class="text-grey-dark">Total</dt>
											<dd class="text-grey-dark">
												<div class="d-flex align-items-center">
													<span class="badge badge-grey">
														<span>EUR</span>
													</span>
													<span class="ml-2">{{ subscription.priceCents | amount }}</span>
												</div>
											</dd>
										</dl>
									</dl>

									<hr class="my-6">
                                    <div class="alert alert-warning small mb-4" role="alert">
                                        L'accès à la plateforme Orthogram sera activé immédiatement après validation du paiement.
                                    </div>
                                    {{ form_start(confirmationForm) }}
                                    {{ form_errors(confirmationForm) }}
                                    <div class="mb-3">
                                        {{ form_row(confirmationForm.agreeTerms, {
                                            label: 'J\'accepte les <a href="'~path('app_terms')~'">conditions générales de vente</a>',
                                            label_html: true,
                                        }) }}
                                    </div>
                                    <div class="mb-3">
                                        {{ form_row(confirmationForm.waiveWithdrawalRight, {
                                            label: 'Je demande expressément l\'accès immédiat à la plateforme Orthogram avant l\'expiration du délai légal de rétractation de 14 jours et je reconnais perdre mon droit de rétractation une fois le service pleinement exécuté.',
                                            label_html: true,
                                        }) }}
                                    </div>
                                    <div class="form-text mb-4">
                                        En poursuivant, vous reconnaissez que l'abonnement souscrit donne accès à un service numérique de formation fourni immédiatement après paiement.
                                    </div>
									<button type="submit" class="btn btn-md kw41uk mt-3">
										<span>Confirmer et passer au paiement</span>
									</button>
									{{ form_end(confirmationForm) }}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="wcxpat">
			<div class="xo2a4n">
				<div class="zxl51y">
					<div class="d-flex align-items-start flex-column">
                            <img
                                class="img-fluid rounded d-none d-md-block"
                                src="{{ asset('img/subscription/formation-orthographe.webp') }}"
                                alt="Illustration de l'abonnement Orthogram"
                            >
                            <img
                                class="thumb thumb-lg d-md-none mr-3"
                                src="{{ asset('img/subscription/formation-orthographe.webp') }}"
                                alt="Illustration de l'abonnement Orthogram"
                            >
						<div class="w-100">
							<h3 class="sb9j1v mt-md-4 mb-1">{{ subscription.title }}</h3>
                            <div class="d-flex flex-column">{{ subscription.priceCents|amount }}</div>

                            {% if subscription.isLifetime %}
                                <small class="text-muted mt-2">Accès illimité</small>
                            {% else %}
                                <small class="text-muted mt-2">Accès valable pendant 1 an</small>
                            {% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{% include "shared/_footer_second.html.twig" %}
{% endblock %}
