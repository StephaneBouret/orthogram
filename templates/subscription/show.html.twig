{% extends 'base.html.twig' %}

{% block title %}
	Abonnement Orthogram
{% endblock %}

{% block body %}
	<section class="py-5">
		<div class="container">
			<div class="row align-items-center g-5">
				<div class="col-lg-6">
					<span class="badge text-bg-light mb-3">Abonnement annuel</span>

					<h1 class="display-5 fw-bold mb-3">
						Accédez à la plateforme Orthogram
					</h1>

					<p class="lead text-muted mb-4">
						Progressez en orthographe grâce à des contenus pédagogiques, des exercices ciblés
						et un parcours de formation accessible depuis votre espace personnel.
					</p>

					<ul class="list-unstyled mb-4">
						<li class="mb-2">✓ Accès à la plateforme Orthogram pendant 1 an</li>
						<li class="mb-2">✓ Contenus pédagogiques structurés</li>
						<li class="mb-2">✓ Exercices et évaluations en ligne</li>
						<li class="mb-2">✓ Suivi accessible depuis votre compte</li>
					</ul>

					<div class="d-flex flex-wrap gap-3">
						<a href="{{ app.user ? checkoutPath : loginPath }}" class="btn btn-primary btn-lg">
							Souscrire maintenant
						</a>

						<a href="{{ path('app_terms') }}" class="btn btn-outline-secondary btn-lg">
							Voir les CGV
						</a>
					</div>

					<div class="mt-4 small text-muted">
						{% if app.user %}
							Vous êtes connecté : vous serez redirigé directement vers la page de confirmation de souscription.
						{% else %}
							Si vous n'êtes pas connecté, vous serez invité à vous identifier avant d'accéder au checkout.
						{% endif %}
					</div>
				</div>

				<div class="col-lg-6">
					<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
						<img src="{{ asset('img/subscription/formation-orthographe.webp') }}" class="img-fluid" alt="Illustration de l'abonnement Orthogram">
					</div>
				</div>
			</div>

			<div class="row mt-5 g-4">
				<div class="col-md-4">
					<div class="card h-100 border-0 shadow-sm rounded-4">
						<div class="card-body p-4">
							<h2 class="h5 mb-3">Un parcours structuré</h2>
							<p class="text-muted mb-0">
								Avancez étape par étape dans un programme conçu pour renforcer durablement vos bases en orthographe.
							</p>
						</div>
					</div>
				</div>

				<div class="col-md-4">
					<div class="card h-100 border-0 shadow-sm rounded-4">
						<div class="card-body p-4">
							<h2 class="h5 mb-3">Des exercices ciblés</h2>
							<p class="text-muted mb-0">
								Entraînez-vous avec des exercices adaptés pour consolider vos acquis et identifier vos points à renforcer.
							</p>
						</div>
					</div>
				</div>

				<div class="col-md-4">
					<div class="card h-100 border-0 shadow-sm rounded-4">
						<div class="card-body p-4">
							<h2 class="h5 mb-3">Activation immédiate</h2>
							<p class="text-muted mb-0">
								Une fois votre souscription validée, votre accès à Orthogram est activé immédiatement selon les conditions prévues.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
{% include "shared/_footer_second.html.twig" %}
{% endblock %}
