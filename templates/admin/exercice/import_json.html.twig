{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}{{ isCreation ? 'Créer un exercice depuis un JSON' : 'Importer un JSON' }}{% endblock %}

{% block main %}
    <section class="content-panel">
        <div class="content-panel-body">
            <p>
                {% if isCreation %}
                    Créer un exercice à partir d’un JSON généré par ChatGPT.
                {% else %}
                    Importer les données de l’exercice <strong>{{ exercice.title }}</strong>.
                {% endif %}
                Le JSON peut contenir directement <code>sentences</code>, ou un objet complet avec <code>title</code>, <code>instruction</code>, <code>type</code> et <code>data.sentences</code>.
            </p>

            <form method="post" action="{{ isCreation ? path('admin_exercice_import_json_new') : path('admin_exercice_import_json', { entityId: exercice.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token(isCreation ? 'import_exercice_json_new' : 'import_exercice_json_' ~ exercice.id) }}">

                {% if isCreation %}
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-control-label" for="exercise_title">Titre</label>
                            <input id="exercise_title" name="title" type="text" class="form-control" value="{{ title }}" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="form-control-label" for="exercise_type">Type</label>
                            <select id="exercise_type" name="type" class="form-control">
                                <option value="click_words" {{ type == 'click_words' ? 'selected' : '' }}>Cliquer sur les bons mots</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-control-label" for="exercise_instruction">Consigne</label>
                        <textarea id="exercise_instruction" name="instruction" class="form-control" rows="3" required>{{ instruction }}</textarea>
                    </div>
                {% endif %}

                <div class="form-group">
                    <label class="form-control-label" for="json_content">JSON à importer</label>
                    <textarea
                        id="json_content"
                        name="json_content"
                        class="form-control"
                        rows="24"
                        spellcheck="false"
                        placeholder='{"sentences":[{"id":"s1","words":[{"id":"s1_w1","text":"Sarah","isAnswer":true,"explanation":"Sarah est un nom propre."}]}]}'
                    >{{ jsonContent }}</textarea>
                    <div class="form-text">
                        L’import remplace les phrases de l’exercice. Les identifiants manquants seront générés automatiquement.
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-file-import"></i>
                        {{ isCreation ? 'Créer depuis le JSON' : 'Importer' }}
                    </button>
                    <a class="btn btn-secondary" href="{{ isCreation ? path('admin_exercice_new') : path('admin_exercice_edit', { entityId: exercice.id }) }}">Annuler</a>
                </div>
            </form>
        </div>
    </section>
{% endblock %}
